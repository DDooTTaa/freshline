rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 사용자 프로필 - 본인만 읽기/쓰기 가능
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 공개 작품 - 모든 인증된 사용자가 읽기 가능, 본인만 쓰기 가능
    match /public_creations/{creationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null 
        && resource.data.userId == request.auth.uid;
    }
    
    // 일일 단어 - 모든 인증된 사용자가 읽기 가능
    match /daily_words/{date} {
      allow read: if request.auth != null;
      allow write: if false; // 관리자만 쓰기 가능 (수동 설정)
    }
    
    // 팔로우 관계 - 본인만 읽기/쓰기 가능
    match /users/{userId}/following/{followingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 개인 작품 - 본인만 읽기/쓰기 가능
    match /users/{userId}/creations/{creationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
